# ---------------------------------------------------------------------------
# PickleNepal — environment configuration
# Copy to `.env` and fill in real values. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development

# Public origin. Must match where the app is actually served, because it drives
# canonical links, OpenGraph tags, the sitemap and password-reset links.
# Local (non-Docker): http://localhost:3000
# Docker Compose:     http://localhost:3100  (see WEB_PORT below)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/picklenepal?schema=public

# Secret used to sign session cookies (32+ random chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me-000000000000000000000000

# --- Nepal defaults (§5) ---------------------------------------------------
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kathmandu
NEXT_PUBLIC_APP_CURRENCY=NPR
NEXT_PUBLIC_PHONE_COUNTRY_CODE=+977
DEFAULT_CITY=Kathmandu

# --- Google OAuth (optional, §9.2) -----------------------------------------
# Leave blank to disable Google login entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage / uploads (§64) ----------------------------------------
# S3-compatible (Cloudflare R2 / AWS S3 / MinIO). Leave blank to use local disk.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_MB=5

# --- Maps (§23) ------------------------------------------------------------
# MapLibre is used with a free style; a key is only needed for hosted tiles.
MAP_API_KEY=

# --- Email (§78) ------------------------------------------------------------
# Provider: resend | smtp | console  (console just logs the email)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=PickleNepal <no-reply@picklenepal.com>

# --- Payments (§48) ---------------------------------------------------------
# Providers: esewa | khalti | stripe | mock  (mock simulates, never real money)
PAYMENT_PROVIDER=mock
ESEWA_MERCHANT_ID=
ESEWA_SECRET=
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Platform settings (§49) ------------------------------------------------
PLATFORM_COMMISSION_BPS=1000
PLATFORM_CURRENCY=NPR

# --- Docker Compose host ports ---------------------------------------------
# Offsets are used because 3000 and 5432 are commonly taken by another project
# or a local Postgres. Override if these clash with something on your machine.
WEB_PORT=3100
DB_PORT=5434
