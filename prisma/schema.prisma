  CLUB_ADMIN
  COACH
  ORGANIZER
  SELLER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum City {
  KATHMANDU
  LALITPUR
  BHAKTAPUR
  POKHARA
  CHITWAN
  BIRATNAGAR
  BUTWAL
  DHARAN
