// PickleNepal — Prisma schema
// Reference: REQUIREMENT.md §68 (entity list), §69 (integrity rules), §70 (indexing)
//
// Money is stored as integer minor units (rupees) in Int columns named `*Paisa`
// is avoided — we store whole NPR rupees in Int fields to match `NPR 500` display
// while keeping integers (no float). See §5.3.
//
// All timestamps are stored as UTC `timestamptz` and rendered in Asia/Kathmandu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

